# Copy to .env (git-ignored) and fill in. Read by libs/airspace_common/settings.py.
# Where each secret lives: docs/01-architecture.md#networking-and-security

# --- Collector (docs/04-pipelines.md#p1--collector) ---
# This collector's id
COLLECTOR_ID=pc-daniel
# OpenSky API client (OAuth2 client credentials) from your OpenSky account page
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Seconds between polls (slots are multiples of this since the epoch)
CADENCE_SECONDS=90
# Local spool (pending/, sent/, rejected/, archive/, state/, logs/); relative to the working directory
SPOOL_DIR=spool
# true sends batches to INGEST_URL; false = spool-only mode
UPLOAD_ENABLED=false
# Fetch yesterday's /flights/all at 06:00 UTC
FLIGHT_LISTS_ENABLED=true
# Days of Parquet archives kept on the collector; older ones are deleted once R2 has them
ARCHIVE_RETENTION_DAYS=30
# rclone remote and bucket for the archive; files go under <bucket>/<COLLECTOR_ID>/
RCLONE_REMOTE=r2:airspace-archive
# On the collector: an R2 token limited to airspace-archive (Object Read & Write). The server uses
# the same three names further down, with its own token
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Ingest API. Key: python -m ingest.admin add-collector (printed once)
INGEST_URL=http://airspace-vm:8000/ingest/v1
INGEST_API_KEY=

# --- public-api (docs/05-api-contract.md), role app_reader ---
# Set by compose on the server. For local development, open the tunnel first
# (`ssh -N airspace-db`) and use postgres://app_reader:<password>@127.0.0.1:5432/airspace
# The stream-worker reads DATABASE_URL too, as stream_worker (compose builds it from
# STREAM_WORKER_PASSWORD below).
DATABASE_URL=

# --- Server: infra/.env on the VM (docs/03-data-model.md#roles) ---
# Database role passwords. Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
AIRSPACE_OWNER_PASSWORD=
INGEST_WRITER_PASSWORD=
STREAM_WORKER_PASSWORD=
JOBS_PASSWORD=
APP_READER_PASSWORD=
LLM_READONLY_PASSWORD=
GRAFANA_READER_PASSWORD=
DAGSTER_DB_PASSWORD=
MLFLOW_DB_PASSWORD=
# Read-only role used by the backup job's pg_dump
BACKUP_PASSWORD=
# Grafana's admin login (user admin); generate with: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=

# --- Cloudflare R2 for backups (docs/01-architecture.md#backups) ---
# Account ID from the R2 overview page; an R2 API token with Object Read & Write on
# airspace-backup and airspace-archive
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Carbon-aware operations (docs/adr/0006-carbon-aware-operations.md) ---
# carbon-signal: > 1 speeds up the simulated grid's clock for a demo (60 = one day in 24 min).
# Compose only; on k3s it is set in infra/k8s/carbon-signal.yaml. Defaults: 1, seed 2026.
# SIGNAL_TIME_SCALE=1
# SIGNAL_SEED=2026
# Where jobs reach carbon-signal (default http://carbon-signal:8002, the in-cluster Service)
# CARBON_SIGNAL_URL=
# Where metar_fetch gets METARs (default https://aviationweather.gov/api/data/metar)
# METAR_URL=

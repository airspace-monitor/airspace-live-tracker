{
  "uid": "airspace-ops",
  "title": "Airspace ops",
  "tags": [
    "airspace",
    "ops"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Newest batch age",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM now() - max(received_at)) AS age FROM ops.v_ingest_batches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Seconds since the VM last received a batch from the collector."
    },
    {
      "id": 2,
      "title": "Slot coverage, last 24 h",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE http_status = 200) / 960 AS coverage FROM ops.v_ingest_batches WHERE query_kind = 'states_global' AND requested_at > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Share of the 960 daily 90 s slots with a successful global snapshot (target 95%)."
    },
    {
      "id": 3,
      "title": "Collector gaps, last 7 days",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS gaps FROM core.events WHERE kind = 'collector_gap' AND ts > now() - interval '7 days'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Runs of 4 or more missed slots (collector_gap_check)."
    },
    {
      "id": 4,
      "title": "OpenSky credits left",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT credits_remaining AS credits FROM ops.v_ingest_batches WHERE credits_remaining IS NOT NULL ORDER BY requested_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 200
              },
              {
                "color": "green",
                "value": 800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "From the last batch; the 4,000-credit quota resets about 16:10 UTC."
    },
    {
      "id": 5,
      "title": "State vectors stored per minute",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('15 minutes', requested_at) AS time, sum(n_inserted) / 15.0 AS \"rows/min\" FROM ops.v_ingest_batches WHERE $__timeFilter(requested_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Slot coverage per hour",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 hour', requested_at) AS time, 100.0 * count(*) FILTER (WHERE http_status = 200) / 40 AS \"coverage %\" FROM ops.v_ingest_batches WHERE query_kind = 'states_global' AND $__timeFilter(requested_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Aircraft tracked (airborne, per snapshot)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT t.bucket AS time, sum(t.n_obs)::float / c.n_global_snapshots AS aircraft FROM agg.traffic_h3_15m t JOIN agg.coverage_15m c USING (bucket) WHERE $__timeFilter(t.bucket) GROUP BY t.bucket, c.n_global_snapshots ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Average airborne aircraft with a position per global snapshot (agg.traffic_h3_15m)."
    },
    {
      "id": 8,
      "title": "Upload delay, p95 per hour",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 hour', requested_at) AS time, percentile_cont(0.95) WITHIN GROUP (ORDER BY late_seconds) AS \"p95 delay\" FROM ops.v_ingest_batches WHERE $__timeFilter(requested_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Seconds from the OpenSky request to the batch arriving on the VM. Spikes are backlogs."
    },
    {
      "id": 9,
      "title": "OpenSky credits remaining",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT requested_at AS time, credits_remaining AS credits FROM ops.v_ingest_batches WHERE credits_remaining IS NOT NULL AND $__timeFilter(requested_at) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Collector gaps",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT ts AS \"gap start\", title FROM core.events WHERE kind = 'collector_gap' AND $__timeFilter(ts) ORDER BY ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Recent job runs",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT job, status, started_at, round(extract(epoch FROM finished_at - started_at)) AS seconds, rows_out, error FROM ops.job_runs ORDER BY run_id DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}

{
  "uid": "airspace-sustainability",
  "title": "Airspace sustainability",
  "tags": [
    "airspace",
    "carbon"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Carbon intensity now",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT intensity_g_kwh AS \"gCO2e/kWh\" FROM ops.carbon_readings ORDER BY ts DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 350
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "The latest reading from carbon-signal, the simulated grid (ADR-0006). Green below 200, red above 350: the controller's classes."
    },
    {
      "id": 2,
      "title": "Signal source",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT source FROM ops.carbon_readings ORDER BY ts DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "curve": {
                  "text": "simulated curve",
                  "color": "blue"
                },
                "override": {
                  "text": "demo override",
                  "color": "purple"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      },
      "description": "`curve` while the signal follows its simulated day; `override` while a demo value is pinned."
    },
    {
      "id": 3,
      "title": "Carbon intensity (gCO₂e/kWh)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airspace"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, intensity_g_kwh AS \"intensity\" FROM ops.carbon_readings WHERE $__timeFilter(ts) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airspace"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, intensity_g_kwh AS \"override\" FROM ops.carbon_readings WHERE $__timeFilter(ts) AND source = 'override' ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 350
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "area"
            },
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "override"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 6
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Every 5-minute reading the system stored (carbon_readings_record). Bands: green < 200, yellow, red > 350. Purple points were a demo override."
    }
  ]
}

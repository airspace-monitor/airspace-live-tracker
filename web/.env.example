# Base path the browser calls. In development Vite proxies this to the VM.
# A Cloudflare Pages build must set this to https://api.<domain>/api/v1 (VITE_API_BASE).
VITE_API_BASE=/api/v1
# Dev proxy target. The API is tailnet-only until Cloudflare/Caddy (M1.2, M2.8).
VITE_API_PROXY_TARGET=http://airspace-vm.tailf5a9a6.ts.net:8001
# CARTO basemap API key (Q5). Leave empty to use the OpenFreeMap Dark fallback.
# Do not commit a real key; put it in web/.env, which is git-ignored.
VITE_CARTO_KEY=
# Optional full style URL; takes precedence over VITE_CARTO_KEY (CARTO or OpenFreeMap).
VITE_MAP_STYLE_URL=
